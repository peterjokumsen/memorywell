# Generate a populated copy with: ./scripts/generate-env.sh
BASE_NAME=memwell
ENVIRONMENT=dev
LOCATION=westeurope
# use `az account show --query id -o tsv` to get current subscription ID
SUBSCRIPTION_ID=
# use `LC_ALL=C tr -dc 'A-Za-z0-9' < /dev/urandom | head -c 32; echo` to generate random password for Postgres
POSTGRES_ADMIN_PASSWORD=
# use `az ad signed-in-user show --query id -o tsv` to get ID
COSMOS_USER_OBJECT_ID=
