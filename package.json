{
  "name": "memorywell",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@9.0.0",
  "workspaces": [
    "web"
  ],
  "scripts": {
    "dev:swa": "pnpm --filter web dev:swa",
    "dev:bff": "cd bff && func start --port 7071",
    "dev:all": "pnpm --filter web dev & (cd bff && func start --port 7071) & wait"
  }
}
