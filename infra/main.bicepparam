using './main.bicep'
param baseName = readEnvironmentVariable('BASE_NAME', 'memwell')
param deploymentMode = readEnvironmentVariable('DEPLOYMENT_MODE', 'all')
param environment = readEnvironmentVariable('ENVIRONMENT', 'dev')
param location = readEnvironmentVariable('LOCATION', 'westeurope')
param resourceGroupName = readEnvironmentVariable('RG_NAME', '')
param containerImage = readEnvironmentVariable('IMAGE', 'mcr.microsoft.com/azuredocs/containerapps-helloworld:latest')
param sharedResourceGroupName = readEnvironmentVariable('SHARED_RG_NAME', '')
param acrName = readEnvironmentVariable('SHARED_ACR_NAME', '')
param keyVaultName = readEnvironmentVariable('VAULT_NAME', '')
param postgresAdministratorPassword = readEnvironmentVariable('POSTGRES_ADMIN_PASSWORD', '')
param postgresClientIp = readEnvironmentVariable('CLIENT_IP', '')
param postgresKeyName = readEnvironmentVariable('POSTGRES_CONNECTION_STRING_KEY', '')
param cosmosAccountName = readEnvironmentVariable('COSMOS_ACCOUNT_NAME', '')
param cosmosDatabase = readEnvironmentVariable('COSMOS_DATABASE', '')
param cosmosPrincipalObjectId = readEnvironmentVariable('COSMOS_USER_OBJECT_ID', '')
param redisKeyName = readEnvironmentVariable('REDIS_URL_KEY', '')
